# ==============================================================================
# Variáveis de Ambiente - Template de Exemplo (.env.example)
# Monorepo Restaurante Inteligente
# ==============================================================================

# Ambiente geral (development, staging, production)
ENVIRONMENT=development

# PostgreSQL 16 (RLS + Conexão Transacional)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_seguro_123
POSTGRES_DB=restaurante_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Redis 7 (Cache, Locks, SSE, Blacklist e Rate Limiting)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redis_seguro_123
REDIS_DB=0

# RabbitMQ 3.13 (AMQP Raw JSON)
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# JWT Security (Autenticação e Sessões)
JWT_KEY=DevLocalOnlyKeyNotForProdUseSecure2026!#@$
JWT_ISSUER=RestauranteInteligente
JWT_AUDIENCE=RestauranteInteligente.App
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# Segurança Interna e Webhooks M2M
INTERNAL_SERVICE_API_KEY=dev_internal_service_api_key_2026_local
MERCADO_PAGO_WEBHOOK_SECRET=dev_mp_secret_webhook_key_2026_local

# Frontend React Native / Expo (Público no bundle móvel)
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1
