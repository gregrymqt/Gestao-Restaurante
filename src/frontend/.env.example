# - Web / Local: http://localhost:5000/api/v1
# - Emulador Android: http://10.0.2.2:5000/api/v1
# - Dispositivo físico (Expo Go): http://<IP_LOCAL_DA_MAQUINA>:5000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1
EXPO_PUBLIC_API_ID=restaurante-inteligente-pdv
