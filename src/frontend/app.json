{
  "expo": {
    "name": "Restaurante Inteligente",
    "slug": "restaurante-inteligente",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "restaurante-inteligente",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Restaurante Inteligente",
      "shortName": "Restaurante",
      "themeColor": "#D9381E",
      "backgroundColor": "#FAFAFA",
      "display": "standalone",
      "lang": "pt-BR"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
