{
  "expo": {
    "name": "Restaurante Inteligente",
    "slug": "restaurante-inteligente",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "restaurante-inteligente",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.gregrymqt.restauranteinteligente"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Restaurante Inteligente",
      "shortName": "Restaurante",
      "themeColor": "#D9381E",
      "backgroundColor": "#FAFAFA",
      "display": "standalone",
      "lang": "pt-BR"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "abb973ee-ef9e-4de8-b27c-27d08f83d81b"
      }
    }
  }
}
